;; ============================================================
;; tarstrading.com — BIND zone file for Cloudflare import (FINAL)
;; Upload: Cloudflare dashboard → tarstrading.com → DNS → Records
;;         → Import and Export → Import DNS records → this file.
;;
;; Targets are the live Railway values for project "tars-trading"
;; (service: web). Nothing to edit — import as-is.
;;
;; Cloudflare flattens the apex CNAME automatically. Keep the
;; orange-cloud (proxy) ON for @, www and admin — TLS, HTTP/3 and
;; caching in front of Railway. The _railway-verify TXT records
;; prove domain ownership to Railway; leave them grey-cloud (DNS
;; only, which is automatic for TXT).
;;
;; www strategy: Railway's plan allows two custom domains, spent on
;; @ and admin. www points at the apex and needs ONE redirect rule
;; in Cloudflare (Rules → Redirect Rules → create):
;;   When hostname equals www.tarstrading.com
;;   → 301 to https://tarstrading.com$1 (preserve path).
;; ============================================================

$ORIGIN tarstrading.com.
$TTL 300

;; ---------- Web (Railway: tars-trading/web) ----------
@       IN CNAME 9bhwmtj8.up.railway.app.
admin   IN CNAME 8g1835s1.up.railway.app.
www     IN CNAME tarstrading.com.

;; Railway domain-ownership verification
_railway-verify        IN TXT "railway-verify=railway-verify=6e5adc1b777f96616a32c4006bab53ad68ad0329dd1f99f094ea640e345df3be"
_railway-verify.admin  IN TXT "railway-verify=railway-verify=f6374de78419869c8277ff55e274124d563c3b71a6986d25be0e034bdae47185"

;; ---------- Email ----------
;; Plan: Cloudflare Email Routing (free) receives mail for
;; you@tarstrading.com and forwards to your real inbox. After this
;; import, flip it on: dashboard → Email → Email Routing → Enable,
;; then add addresses (e.g. abdullah@, support@, hello@) and their
;; forwarding destinations. Cloudflare inserts its three MX records
;; itself at that moment — do NOT hand-enter MX records here.
;;
;; SPF — authorizes Cloudflare's relay for this domain. If you later
;; move to real mailboxes (Google Workspace / Zoho / iCloud+), replace
;; this include with the provider's and add their MX + DKIM records.
@       IN TXT   "v=spf1 include:_spf.mx.cloudflare.net ~all"

;; DMARC — start at p=none (monitor only) so nothing legitimate is
;; dropped while the domain builds reputation; tighten to
;; p=quarantine after a clean week of reports.
_dmarc  IN TXT   "v=DMARC1; p=none; rua=mailto:tarsitgroup@outlook.com; fo=1"
